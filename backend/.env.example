# --- FARO — Foundation Layer — Variables de entorno ---
# Copiar como .env y completar con valores reales.
# NUNCA commitear el .env real.

ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=faro_user
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=faro_db
POSTGRES_HOST=faro-postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=faro-redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis

# --- Authentication (Phase 2) ---

# Generar con: openssl rand -hex 64
JWT_SECRET_KEY=changeme_generate_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Rate limiting del router /auth (requests por minuto, por IP)
AUTH_RATE_LIMIT_PER_MINUTE=10

# Google Sign-In — Client ID de la app Android en Google Cloud Console
GOOGLE_CLIENT_ID=

# URLs base usadas para construir los links de verificación/reset
# (hasta integrar el proveedor de email real, ver app/services/email_service.py)
EMAIL_VERIFICATION_URL_BASE=https://api.faro.kvnttech.com/api/v1/auth/verify-email
PASSWORD_RESET_URL_BASE=https://api.faro.kvnttech.com/api/v1/auth/reset-password
